# このファイルをコピーして .env を作成してください。
#
#   cp .env.example .env
#
# SECRET_KEY は必ず自分で生成した値に差し替えてください。
# 生成コマンド（$ を含まない URL-safe な文字列を作ります）:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# 【注意】値に $ を含めないでください。
# Docker Compose が .env の $xxx を変数として展開してしまうため、
# SECRET_KEY が壊れた状態で Django に渡ります（エラーにならないので気づきにくい）。

# 必須。Django の暗号署名に使われる秘密鍵（セッション・CSRF トークンなど）
DJANGO_SECRET_KEY=ここに生成した値を貼り付ける

# 開発時は True。本番では必ず False にする
DJANGO_DEBUG=True

# アクセスを許可するホスト名（カンマ区切り）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# 本番（docker-compose.prod.yml）。開発では書かなくてよい。手順は Wiki「本番公開」
# ---------------------------------------------------------------------------
# 本番では上の DJANGO_DEBUG は compose が False に固定する。ALLOWED_HOSTS は公開するドメインにする。
#
#   DJANGO_ALLOWED_HOSTS=example.com
#
# 公開するドメイン（Caddy が証明書を取る。DNS をこの VM の IP に向けておく）
#   SITE_DOMAIN=example.com
#
# ログインなどの POST が通るように、https:// 付きのオリジン（カンマ区切り）
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
