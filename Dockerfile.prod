# 本番用イメージ（開発用は Dockerfile）。ビルドは README ではなく Wiki「本番公開」を参照。
#
#   docker build -f Dockerfile.prod -t baseball-prod .

# --- 1段目: React アイランドをビルドする（Node は最終イメージに入れない） ---
FROM node:22-bookworm-slim AS frontend
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# vite.config.ts の outDir は ../myapp/static/myapp/dist
RUN npm run build

# --- 2段目: 本番の Python イメージ（requirements.txt だけ。開発用の依存は入れない） ---
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_PRODUCTION_STATIC=True \
    DJANGO_SQLITE_WAL=True \
    DJANGO_LOG_TO_STDOUT=True \
    DJANGO_DB_PATH=/data/db.sqlite3

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
COPY --from=frontend /app/myapp/static/myapp/dist/ myapp/static/myapp/dist/
RUN chmod +x deploy/entrypoint.sh

# collectstatic は SECRET_KEY を読むため、ビルド時だけダミーを渡す（イメージには残らない）
RUN DJANGO_SECRET_KEY=build-only python manage.py collectstatic --noinput

# root 以外で動かす。/data は DB のボリュームの置き場（compose がボリュームを重ねる）
RUN useradd --uid 10001 --no-create-home app \
    && mkdir /data \
    && chown app /data
USER app

EXPOSE 8000

ENTRYPOINT ["/app/deploy/entrypoint.sh"]

# 起動時にマイグレーションを反映してから gunicorn を立てる（entrypoint.sh）。
# 同期ワーカー2本・タイムアウト60秒（1GB の VM でメモリに余裕を残すため）。
# SQLite は書き込みが直列なので、増やしても書き込みは速くならない。
# アクセスログは標準出力へ（docker compose logs で読める）。制御用ソケット（gunicorn 26 の既定）は
# ホームの無い利用者では作れずエラーになり、使わないので切る。
# アクセスログの先頭は、既定の %(h)s（接続元＝cloudflared の IP）ではなく CF-Connecting-IP（利用者の IP）にする
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--timeout", "60", "--access-logfile", "-", "--access-logformat", "%({cf-connecting-ip}i)s %(l)s %(u)s %(t)s \"%(r)s\" %(s)s %(b)s \"%(f)s\" \"%(a)s\"", "--no-control-socket"]
