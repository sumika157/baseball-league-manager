# 仮想環境（Linux 用の venv はコンテナでは使わない）
venv/
env/
.venv/

# Python キャッシュ
__pycache__/
*.py[cod]
*$py.class

# データベースはイメージに焼き込まず、ボリュームマウントで渡す
db.sqlite3
db.sqlite3-journal
db.sqlite3-wal
db.sqlite3-shm

# 秘密情報はイメージに焼き込まず、env_file で渡す
.env

# Git 関連
.git/
.gitignore

# Docker 関連
Dockerfile
docker-compose.yml
.dockerignore

# その他
*.log
.claude/
.vscode/
.idea/
.DS_Store
README.md

# フロントエンドの生成物（gitignore 済み。ソースはバインドマウントで渡るのでイメージに不要）。
# node_modules/.bin のシンボリックリンクは Windows 側（U:）からのビルドで
# 「invalid file request」になり、ビルドが止まる
frontend/node_modules/
myapp/static/myapp/dist/

# collectstatic の出力先（イメージ内で作るので持ち込まない）
staticfiles/
# 本番 VM の backup_db の出力先
backups/
