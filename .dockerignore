# 仮想環境（Linux 用の venv はコンテナでは使わない）
venv/
env/
.venv/

# Python キャッシュ
__pycache__/
*.py[cod]
*$py.class

# データベースはイメージに焼き込まず、ボリュームマウントで渡す
db.sqlite3
db.sqlite3-journal

# 秘密情報はイメージに焼き込まず、env_file で渡す
.env

# Git 関連
.git/
.gitignore

# Docker 関連
Dockerfile
docker-compose.yml
.dockerignore

# その他
*.log
.claude/
.vscode/
.idea/
.DS_Store
README.md
